# Copiar a .env y ajustar. Nunca commitear .env real.

# Conexión de la API a PostgreSQL, usando el rol de privilegios mínimos app_api
# (creado en database/10_roles.sql). NUNCA usar el usuario admin/postgres aquí.
DATABASE_URL=postgresql://app_api:app_api_dev_only@localhost:5433/datamarket

# Secreto para firmar JWT. Generar uno propio por entorno, p.ej.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-dev-only
JWT_EXPIRE_MINUTES=30

# Usado SOLO por scripts/create_admin.py (conexión directa como superusuario
# para poder crear o actualizar el admin inicial). No lo usa la API en runtime.
PG_ADMIN_DSN=postgresql://postgres:postgres@localhost:5433/datamarket
