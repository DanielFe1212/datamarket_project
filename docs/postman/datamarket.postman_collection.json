{
  "info": {
    "name": "DataMarket API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Orden sugerido: carpeta 0 (logins, guardan los tokens) → 1 (lectura) → 2 (compras) → 3 (casos de error/permisos). Requiere el servidor en {{base_url}}."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_operador",
      "value": ""
    },
    {
      "key": "token_analista",
      "value": ""
    },
    {
      "key": "token_auditor",
      "value": ""
    },
    {
      "key": "token_cliente",
      "value": ""
    },
    {
      "key": "pedido_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0. Auth (correr primero)",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_admin', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
